    <part id="agents-meet-apis">
      <title>Agents Meet Your APIs</title>
      <slide id="design-vs-runtime">
        <title>Developer Experience (DX) vs. Agent Experience (AX)</title>
        <table style="border-collapse: collapse ; border: 2px solid #000000 ;">
          <tr>
            <th style="border: 2px solid #000000 ; padding: 10px 20px ; background: #eeeeee ;"></th>
            <th style="border: 2px solid #000000 ; padding: 10px 20px ; background: #eeeeee ;">Developer (DX)</th>
            <th style="border: 2px solid #000000 ; padding: 10px 20px ; background: #eeeeee ;">Agent (AX)</th>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Uses the capability</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Through an application</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Directly</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">When</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Design time</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Runtime</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Use case knowledge</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Coded into the application, a workflow</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Found dynamically, best matching tool for now</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Context</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Experience, colleagues, documentation</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">What the tools and their descriptions say</td>
          </tr>
        </table>
      </slide>
      <slide id="four-dimensions">
        <title>Four Places Where Agents Stumble</title>
        <table style="border-collapse: collapse ; border: 2px solid #000000 ;">
          <tr>
            <th style="border: 2px solid #000000 ; padding: 10px 20px ; background: #eeeeee ;"></th>
            <th style="border: 2px solid #000000 ; padding: 10px 20px ; background: #eeeeee ;">Where the agent stumbles</th>
            <th style="border: 2px solid #000000 ; padding: 10px 20px ; background: #eeeeee ;">In the experiment</th>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Discovery</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">The agent does not know what it can do</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Partly observed</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Semantics</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Descriptions that only make sense with the documentation</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Not tested</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Composition</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Calls that only get something done when chained</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Observed</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Errors</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Responses that derail the agent or do not help it recover</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Partly observed</td>
