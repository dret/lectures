            <th style="border: 2px solid #000000 ; padding: 10px 20px ; background: #eeeeee ;"></th>
            <th style="border: 2px solid #000000 ; padding: 10px 20px ; background: #eeeeee ;">Technique</th>
            <th style="border: 2px solid #000000 ; padding: 10px 20px ; background: #eeeeee ;">Effort</th>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">1</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Check your APIs for AI readiness</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Easy</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">2</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Improve the descriptions</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Easy, if automated</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">3</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Improve the API designs</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">More involved</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">4</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Orchestrate tools into fewer, task-oriented tools</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">More involved</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">5</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Orchestrate deterministically (Arazzo or similar)</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">More involved</td>
          </tr>
          <tr>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">6</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Select or search the tools</td>
            <td style="border: 2px solid #000000 ; padding: 10px 20px ;">Different pattern</td>
          </tr>
        </table>
